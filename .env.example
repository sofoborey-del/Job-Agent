DB_MODE=embedded
PGLITE_DATA_DIR=./local-data/pglite
ARTIFACT_DATA_DIR=./local-data/artifacts
DATABASE_URL=
APP_TIMEZONE=Europe/London
APP_ENCRYPTION_KEY_ID=local-v1
APP_ENCRYPTION_KEY_BASE64=
PROFILE_ADMIN_TOKEN=
API_HOST=127.0.0.1
API_PORT=3210
# local is the default. discovery_only is for a no-public-port, outbound-only hosted worker.
AGENT_DEPLOYMENT_MODE=local
AGENT_USER_ID=
# The bundled practice job site. It must be a loopback address; the agent refuses to start otherwise.
FAKE_ATS_HOST=127.0.0.1
FAKE_ATS_PORT=3311
FAKE_ATS_ORIGIN=http://127.0.0.1:3311
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_TICK_INTERVAL_SECONDS=900
QUIET_HOURS_START=22
QUIET_HOURS_END=7
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
DISCORD_CHANNEL_ID=
# Free personal key from https://developer.adzuna.com/. Without both values the Adzuna source
# refuses to run. Their terms permit personal research: https://developer.adzuna.com/docs/terms_of_service
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Applying by email, for vacancies whose advert explicitly asks candidates to apply that way.
# Off by default, refused in discovery_only mode, and refused without every value below.
# Set up with: pnpm email:authorise, then pnpm email:check --send you@example.com
EMAIL_APPLICATIONS_ENABLED=false
# gmail is the only implemented provider. Its scope is send-only and grants no mailbox access.
EMAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
LLM_PROVIDER=
LLM_API_KEY=
